<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>af.ico</ApplicationIcon>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="data\**\*.cs" />
    <None Remove="data\**\*" />
    <Content Include="af.ico" />
    <Content Include="data\**\*.png;data\**\*.json;data\**\*.vert;data\**\*.frag;data\**\*.ttf;data\**\*.otf;data\**\*.wav;data\**\*.flac;data\**\*.obj;data\**\*.mtl;data\**\*.lua">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MoonSharp" Version="2.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\VoxelgineEngine\VoxelgineEngine.csproj" />
    <ProjectReference Include="..\Voxelgine.Audio\Voxelgine.Audio.csproj" />
    <ProjectReference Include="..\thirdparty\FishGfx\FishGfx\FishGfx.csproj" />
    <ProjectReference Include="..\thirdparty\FishGfx\FishGfx.FishUI\FishGfx.FishUI.csproj" />
    <ProjectReference Include="..\thirdparty\FishGfx\thirdparty\FishUI\FishUI\FishUI.csproj" />
  </ItemGroup>

</Project>
